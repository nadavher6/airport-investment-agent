{
  "name": "airport-investment-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI agent that ranks US airports for modernization investment based on congestion and unmet demand.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @airport/server",
    "dev:web": "npm run dev -w @airport/web",
    "build": "npm run build -w @airport/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "data:download": "bash scripts/download-faa-enplanements.sh"
  },
  "author": "nadavher6",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  }
}
