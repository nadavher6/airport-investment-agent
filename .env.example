# Copy this file to .env and fill in your own keys. Do NOT commit .env.

# Pick one AI provider (all have free tiers):
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Claude (headless session): uses your local `claude` login. Found on PATH unless set here.
# CLAUDE_BIN=/path/to/claude
# CLAUDE_MODEL=sonnet

# Optional aviation data API keys (add as needed):
# AVIATIONSTACK_API_KEY=
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=
